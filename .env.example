# Copy this file to .env and set a password for your LOCAL database.
# Empty database/user/port values use the safe local defaults in Compose.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=
API_BIND_ADDRESS=
API_PORT=

# Only needed for the optional local MinIO / Mailpit tools.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=
MINIO_CONSOLE_PORT=
MAILPIT_WEB_PORT=
MAILPIT_SMTP_PORT=
