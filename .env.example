# Server-side Supabase Postgres settings; copy to .env and fill these in locally.
# From Dashboard > Connect > Direct connection (or Session pooler for IPv4),
# copy the HOST, PORT and USER. Do not paste a password into DATABASE_URL.
# Example format: jdbc:postgresql://db.PROJECT_REF.supabase.co:5432/postgres
DATABASE_URL=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_POOL_SIZE=4

# Download the project's server root certificate from Database Settings.
# This is the host-side file path; Compose mounts it read-only into the API.
SUPABASE_CA_CERT_PATH=./secrets/supabase-ca.crt
API_BIND_ADDRESS=
API_PORT=

# API authentication.
# JWT_SECRET signs every access token and must be at least 32 bytes.
# Generate one locally with `openssl rand -hex 32`; never reuse it and never
# commit it. Left blank, the API signs with an ephemeral key: fine for a
# throwaway local run, but every restart logs everyone out.
JWT_SECRET=
# Optional: the `iss` claim of issued tokens. Must stay a URI.
JWT_ISSUER=https://fixloop.local
# Comma-separated domains allowed to register students.
ALLOWED_EMAIL_DOMAINS=bmu.edu.in
# Comma-separated browser origins allowed to call the API (for the Flutter web
# build). Leave blank to refuse all cross-origin browser requests.
ALLOWED_WEB_ORIGINS=
# Only set true behind a reverse proxy that sets X-Forwarded-For; otherwise a
# client could choose its own rate-limiting key.
TRUST_FORWARDED_FOR=false

# Where uploaded photographs are written. Leave blank for a temporary directory
# locally; a deployment must set a persistent path or photos vanish on restart.
ATTACHMENT_STORAGE_DIR=
ATTACHMENT_MAX_BYTES=8388608

# Only needed for the optional local MinIO / Mailpit tools.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=
MINIO_CONSOLE_PORT=
MAILPIT_WEB_PORT=
MAILPIT_SMTP_PORT=
